{
  "name": "storybook-addon-tag-badges",
  "version": "0.0.0-semantically-released",
  "description": "Display Storybook tags as badges in the sidebar and toolbar.",
  "keywords": [
    "storybook-addon",
    "storybook",
    "badges",
    "tags",
    "organize"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sidnioulz/storybook-addon-tag-badges.git"
  },
  "type": "module",
  "author": "Steve Dodier-Lazaro <sidnioulz@gmail.com>",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./manager-helpers": "./dist/manager-helpers.js",
    "./manager": "./dist/manager.js",
    "./preview": {
      "types": "./dist/preview.d.ts",
      "default": "./dist/preview.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "manager.js",
    "preview.js"
  ],
  "bundler": {
    "managerEntries": [
      "src/manager.tsx",
      "src/manager-helpers.ts"
    ],
    "nodeEntries": [],
    "previewEntries": [
      "src/preview.ts",
      "src/index.ts"
    ]
  },
  "scripts": {
    "build": "tsup",
    "build:storybook": "storybook build",
    "build:watch": "pnpm build --watch",
    "clean": "rimraf ./dist",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "eslint --cache .",
    "lint:fix": "pnpm lint --fix",
    "pack": "pnpm pack --out storybook-addon-tag-badges-$(date +%s).tgz",
    "prebuild": "pnpm clean",
    "prepare": "husky",
    "prerelease": "zx scripts/prepublish-checks.js",
    "release": "pnpm build && pnpm semantic-release",
    "release:canary": "pnpm build && auto canary",
    "start": "run-p build:watch \"storybook --quiet\"",
    "storybook": "storybook dev -p 6006",
    "test": "vitest",
    "test:coverage": "vitest --coverage"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "5.6.0",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9.39.5",
    "@semantic-release/github": "^12.0.11",
    "@semantic-release/npm": "^13.2.0",
    "@storybook/addon-a11y": "11.0.0-beta.3",
    "@storybook/addon-docs": "11.0.0-beta.3",
    "@storybook/addon-mcp": "11.0.0-beta.3",
    "@storybook/addon-vitest": "11.0.0-beta.3",
    "@storybook/icons": "^2.2.0",
    "@storybook/react-vite": "11.0.0-beta.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/browser": "5.1.0",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-istanbul": "5.1.0",
    "auto": "^11.3.6",
    "boxen": "^9.0.0",
    "chromatic": "^18.14.4",
    "commitlint": "^21.2.4",
    "dedent": "^1.7.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-storybook": "11.0.0-beta.3",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "lint-staged": "^17.6.1",
    "npm-run-all": "^4.1.5",
    "playwright": "^1.65.1",
    "prettier": "^3.10.1",
    "prompts": "^2.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rimraf": "^6.1.4",
    "semantic-release": "^26.0.1",
    "storybook": "11.0.0-beta.3",
    "tosource": "2.0.0-alpha.3",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "zx": "^8.8.5"
  },
  "peerDependencies": {
    "storybook": "^11.0.0-beta.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.12"
  },
  "storybook": {
    "displayName": "Tag Badges",
    "supportedFrameworks": [
      "supported-frameworks"
    ],
    "icon": "https://raw.githubusercontent.com/Sidnioulz/storybook-addon-tag-badges/main/static/icon.png"
  },
  "dependencies": {
    "memoizerific": "^1.11.3"
  }
}
