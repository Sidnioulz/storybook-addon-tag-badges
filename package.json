{
  "name": "storybook-addon-tag-badges",
  "version": "0.0.0-semantically-released",
  "description": "Display Storybook tags as badges in the sidebar and toolbar.",
  "keywords": [
    "storybook-addon",
    "storybook",
    "badges",
    "tags",
    "organize"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sidnioulz/storybook-addon-tag-badges.git"
  },
  "type": "module",
  "author": "Steve Dodier-Lazaro <sidnioulz@gmail.com>",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./manager-helpers": "./dist/manager-helpers.js",
    "./manager": "./dist/manager.js",
    "./preview": {
      "types": "./dist/preview.d.ts",
      "default": "./dist/preview.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "manager.js",
    "preview.js"
  ],
  "bundler": {
    "managerEntries": [
      "src/manager.tsx",
      "src/manager-helpers.ts"
    ],
    "nodeEntries": [],
    "previewEntries": [
      "src/preview.ts",
      "src/index.ts"
    ]
  },
  "scripts": {
    "build": "tsup",
    "build:storybook": "storybook build",
    "build:watch": "pnpm build --watch",
    "clean": "rimraf ./dist",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "eslint --cache .",
    "lint:fix": "pnpm lint --fix",
    "pack": "pnpm pack --out storybook-addon-tag-badges-$(date +%s).tgz",
    "prebuild": "pnpm clean",
    "prepare": "husky",
    "prerelease": "zx scripts/prepublish-checks.js",
    "release": "pnpm build && pnpm semantic-release",
    "release:canary": "pnpm build && auto canary",
    "start": "run-p build:watch \"storybook --quiet\"",
    "storybook": "storybook dev -p 6006",
    "test": "vitest",
    "test:coverage": "vitest --coverage"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "5.4.0-next.0",
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint/js": "^9.39.5",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@storybook/addon-a11y": "11.0.0-alpha.0",
    "@storybook/addon-docs": "11.0.0-alpha.0",
    "@storybook/addon-mcp": "11.0.0-alpha.0",
    "@storybook/addon-vitest": "11.0.0-alpha.0",
    "@storybook/icons": "^2.1.0",
    "@storybook/react-vite": "11.0.0-alpha.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^25.9.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/browser": "4.1.10",
    "@vitest/browser-playwright": "4.0.18",
    "@vitest/coverage-istanbul": "4.0.18",
    "auto": "^11.3.6",
    "boxen": "^8.0.1",
    "chromatic": "^13.3.5",
    "commitlint": "^20.5.3",
    "dedent": "^1.7.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-storybook": "11.0.0-alpha.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "lint-staged": "^16.4.0",
    "minimatch": "^10.2.6",
    "npm-run-all": "^4.1.5",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "prompts": "^2.4.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rimraf": "^6.1.3",
    "semantic-release": "^25.0.9",
    "storybook": "11.0.0-alpha.0",
    "tosource": "2.0.0-alpha.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "zx": "^8.8.5"
  },
  "peerDependencies": {
    "storybook": "^11.0.0-alpha.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@10.7.0",
  "engines": {
    "node": ">=22.12"
  },
  "storybook": {
    "displayName": "Tag Badges",
    "supportedFrameworks": [
      "supported-frameworks"
    ],
    "icon": "https://raw.githubusercontent.com/Sidnioulz/storybook-addon-tag-badges/main/static/icon.png"
  },
  "dependencies": {
    "memoizerific": "^1.11.3"
  },
  "pnpm": {
    "overrides": {
      "@octokit/request-error@>=1.0.0 <5.1.1": ">=5.1.1",
      "@octokit/plugin-paginate-rest@>=1.0.0 <9.2.2": ">=9.2.2",
      "@octokit/request@>=1.0.0 <8.4.1": ">=8.4.1",
      "@vitest/browser@>=4.0.17 <4.1.6": ">=4.1.6",
      "esbuild@>=0.27.3 <0.28.1": ">=0.28.1",
      "@vitest/browser@>=4.0.0 <4.1.10": ">=4.1.10",
      "@vitest/browser@>=4.0.0 <=4.1.7": ">=4.1.8",
      "@vitest/mocker@>=2.1.0 <4.1.11": ">=4.1.11"
    }
  }
}
